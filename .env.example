# Copie para .env (desenvolvimento) ou cadastre como variáveis de ambiente no servidor.
DATABASE_URL=postgres://usuario:senha@host:5432/credicontrole
# 1 quando o Postgres exige SSL (Render, Neon, Supabase)
PGSSL=0
# Texto longo e aleatório; trocar desliga todas as sessões
SESSION_SECRET=troque-por-um-texto-longo-e-aleatorio
# Primeiro administrador (só é usado quando ainda não existe nenhum usuário)
ADMIN_EMAIL=admin@exemplo.com.br
ADMIN_SENHA=troque-esta-senha
PORT=3300
